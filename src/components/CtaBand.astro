---
import SectionLabel from './SectionLabel.astro';
import { site } from '../data/site';

/**
 * The full-width rust CTA that closes every page.
 */
interface Props {
  label?: string;
  heading?: string;
  text?: string;
}

const {
  label = 'Chicago & nearby suburbs',
  heading = 'One conversation can get the project moving.',
  text = 'Contact Martin directly to discuss flooring, stairs, railings, painting, carpentry, or another home-improvement job.',
} = Astro.props;
---

<section class="cta">
  <div class="frame cta-inner">
    <div class="cta-copy">
      <SectionLabel text={label} class="cta-label" />
      <h2>{heading}</h2>
      <p>{text}</p>
    </div>

    <div class="cta-actions">
      <a class="action" href={`tel:${site.phoneHref}`}>
        <span class="action-label">Call {site.contactName}</span>
        <span class="action-value">{site.phone}</span>
        <span class="action-cue">Tap to call <span aria-hidden="true">↗</span></span>
      </a>

      <a class="action" href={`mailto:${site.email}`}>
        <span class="action-label">Email {site.contactName}</span>
        <span class="action-value action-value--email">{site.email}</span>
        <span class="action-cue">Tap to email <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: linear-gradient(105deg, var(--rust-a) 0%, var(--rust-b) 55%, #7d3e26 100%);
    color: var(--text-on-dark);
    padding-block: clamp(3.5rem, 2rem + 6vw, 7rem);
    border-top: var(--rule-accent) solid var(--orange);
  }

  .cta-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    align-items: center;
  }

  h2 {
    font-size: var(--fs-h2);
    max-width: 14ch;
  }

  .cta-copy p {
    margin-top: 1.75rem;
    max-width: 42ch;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: rgba(254, 248, 239, 0.82);
  }

  /* The label sits in cream here — orange has too little contrast on rust. */
  .cta-copy :global(.cta-label) {
    color: rgba(254, 248, 239, 0.9);
  }

  .cta-actions {
    border-top: 1px solid rgba(254, 248, 239, 0.35);
  }

  .action {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem) 0;
    transition: background-color 0.2s var(--ease);
  }

  .action + .action {
    border-top: 1px solid rgba(254, 248, 239, 0.22);
  }

  .action:hover,
  .action:focus-visible {
    background: rgba(254, 248, 239, 0.07);
  }

  .action-label,
  .action-cue {
    font-size: var(--fs-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: rgba(254, 248, 239, 0.78);
    white-space: nowrap;
  }

  .action-value {
    min-width: 0;
    font-size: clamp(1.05rem, 0.9rem + 0.8vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* Sized so the full address fits on one line in this three-column row;
     `anywhere` is a last-resort fallback at very narrow widths only. */
  .action-value--email {
    font-size: clamp(0.8125rem, 0.7rem + 0.4vw, 1rem);
    overflow-wrap: anywhere;
  }

  @media (max-width: 60rem) {
    .cta-inner {
      grid-template-columns: minmax(0, 1fr);
    }
    h2 {
      max-width: none;
    }
  }

  @media (max-width: 40rem) {
    .action {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }
    .action-cue {
      margin-top: 0.4rem;
    }
  }
</style>
