---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import type { PublishedProject } from '../lib/projects';

/**
 * Mosaic gallery of completed work.
 *
 * The design shows one large tile beside two stacked tiles, then a row of
 * three. Martin adds projects over time, so rather than hard-coding those
 * positions the grid promotes the first `featured` project to the large tile
 * and flows everything else after it. Any project count reads correctly.
 */
interface Props {
  projects: PublishedProject[];
  /** Cap the number shown; the home page uses this, /projects/ does not. */
  limit?: number;
}

const { projects, limit } = Astro.props;

// Already ordered by getPublishedProjects: featured first, then newest.
const shown = limit ? projects.slice(0, limit) : projects;

// The lead tile covers a 2x2 block of a four-column grid, so it consumes four
// cells while every other tile consumes one. The row only fills exactly when
// 4 + (n - 1) is divisible by 4, i.e. when n % 4 === 1 (5, 9, 13...).
// At any other count the mosaic would leave a visible hole, so we fall back to
// a uniform grid. Martin adding a fifth project switches it on automatically.
const useMosaic = shown.length % 4 === 1 && shown.length >= 5;
---

<ul class:list={['grid', { mosaic: useMosaic }]}>
  {
    shown.map((project, i) => (
      <li class:list={['tile', { 'tile-lead': useMosaic && i === 0 }]}>
        <a href={url(`/projects/${project.id}/`)}>
          <Image
            src={project.data.cover}
            alt={project.data.coverAlt}
            widths={useMosaic && i === 0 ? [480, 720, 1100] : [360, 560, 840]}
            sizes={
              useMosaic && i === 0
                ? '(max-width: 55rem) 100vw, 50vw'
                : '(max-width: 55rem) 100vw, 33vw'
            }
            loading="lazy"
            class="tile-img"
          />
          <span class="tile-caption">
            <span class="tile-category">{project.data.category}</span>
            <span class="tile-title">{project.data.title}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: clamp(0.75rem, 0.4rem + 1vw, 1.25rem);
  }

  .tile a {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-bottom: var(--rule-accent) solid var(--terracotta);
  }

  .tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Slightly portrait. Job photographs are taken on a phone held upright,
       so a landscape tile centre-crops them and throws away the top and
       bottom of every composition. */
    aspect-ratio: 4 / 5;
    transition: scale 0.5s var(--ease);
  }

  /* The lead tile spans two columns and two rows on wide screens, which is
     what produces the mosaic in the design. Only applied when the tile count
     fills the grid exactly — see useMosaic in the component script. */
  @media (min-width: 55rem) {
    .grid.mosaic {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: minmax(0, 1fr);
    }

    .tile-lead {
      grid-column: span 2;
      grid-row: span 2;
    }

    .tile-lead .tile-img {
      aspect-ratio: auto;
      min-height: 26rem;
    }
  }

  .tile a:hover .tile-img,
  .tile a:focus-visible .tile-img {
    scale: 1.03;
  }

  .tile-caption {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 0.3rem;
    padding: clamp(1rem, 0.8rem + 1vw, 1.75rem);
    background: linear-gradient(to top, rgba(4, 14, 11, 0.9) 15%, rgba(4, 14, 11, 0) 100%);
    color: var(--text-on-dark);
  }

  .tile-category {
    font-size: var(--fs-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--orange);
  }

  .tile-title {
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
</style>
