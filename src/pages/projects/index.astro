---
import { getPublishedProjects } from '../../lib/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';

const projects = await getPublishedProjects();
---

<BaseLayout
  title="Completed Projects | Flooring, Stairs & Railings"
  description="Hardwood flooring, staircase and railing projects completed by Star 4 Construction for homes across Chicago's western and southwest suburbs."
  canonical="/projects/"
  breadcrumbs={[{ name: 'Work', href: '/projects/' }]}
>
  <PageHeader
    label="Selected work"
    title="Built details. Finished spaces."
    lede="Flooring, stair, and railing work completed for homes in the Chicago area."
    breadcrumbs={[{ name: 'Work', href: '/projects/' }]}
  />

  <section class="section gallery">
    <div class="frame">
      {
        projects.length > 0 ? (
          <ProjectGrid projects={projects} />
        ) : (
          <p class="empty">
            Project photographs are being added. Call {site.contactName} at{' '}
            <a href={`tel:${site.phoneHref}`}>{site.phone}</a> to discuss recent work.
          </p>
        )
      }
    </div>
  </section>

  <CtaBand heading="Start a project of your own." />
</BaseLayout>

<style>
  .gallery {
    background: var(--ink);
    color: var(--text-on-dark);
  }

  .empty {
    color: var(--text-on-dark-muted);
  }

  .empty a {
    color: var(--orange);
    font-weight: 700;
  }
</style>
