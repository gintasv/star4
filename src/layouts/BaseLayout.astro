---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { localBusinessSchema, breadcrumbSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Absolute path, e.g. "/services/stairs/". Defaults to the current URL. */
  canonical?: string;
  /** Additional JSON-LD nodes for this page. */
  schemas?: unknown[];
  /** Breadcrumb trail. Home is prepended automatically. */
  breadcrumbs?: { name: string; href: string }[];
  /** Absolute or site-relative OG image. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  schemas = [],
  breadcrumbs = [],
  ogImage = site.defaultOgImage,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const origin = Astro.site?.origin ?? 'https://star4construction.com';
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, origin).href;
const ogImageUrl = new URL(ogImage, origin).href;

// The business node appears on every page; it is the anchor other nodes
// reference by @id.
const allSchemas: unknown[] = [localBusinessSchema(origin), ...schemas];

if (breadcrumbs.length > 0) {
  allSchemas.push(
    breadcrumbSchema(origin, [{ name: 'Home', href: '/' }, ...breadcrumbs]),
  );
}
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Preloading the one variable font removes it from the critical path and
        keeps the heavy display headings from flashing in a fallback face. */}
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#141a1b" />
    <meta name="format-detection" content="telephone=yes" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      allSchemas.map((schema) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema)}
        />
      ))
    }
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
